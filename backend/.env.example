NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/attendance-system

JWT_SECRET=replace-with-a-long-random-string

# Minutes a sign-in lasts before the user is logged out automatically (default 15)
SESSION_TIMEOUT_MINUTES=15

# Comma-separated list of allowed frontend origins (for CORS). On Vercel the
# deployment's own URLs are allowed automatically; list extra custom domains here.
CLIENT_URL=http://localhost:5173

STANDARD_SHIFT_HOURS=8

# Office timezone: decides which day a punch belongs to (default Asia/Baghdad)
APP_TIMEZONE=Asia/Baghdad

# Optional geofencing defaults. Admins set it from the dashboard (النطاق الجغرافي);
# these apply only until the first save there.
GEOFENCE_ENABLED=false
GEOFENCE_LAT=
GEOFENCE_LNG=
GEOFENCE_RADIUS_METERS=500
GEOFENCE_MAX_ACCURACY_METERS=200
